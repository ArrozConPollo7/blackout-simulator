# Copia este archivo a .env.local (ignorado por git) y rellena los valores.
# En Vercel, estas variables se configuran en el panel del proyecto.

# URL del Cloudflare Worker (la API del juego). Nunca deja "/" al final.
# Local con `npm run dev:api`: http://127.0.0.1:8787
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Supabase — solo para Realtime. Son valores públicos por diseño.
NEXT_PUBLIC_SUPABASE_URL=https://tbwtphcydwhpeqmdfmlo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-clave-publica

# Contraseña de la consola del Host (/host). Debe coincidir con HOST_PASSCODE en el
# Worker. Es un guardia de aula, no un secreto fuerte: el proyector queda a la vista de
# todos, pero los controles no. Si el Worker no define HOST_PASSCODE, vale 9806.
# (NEXT_PUBLIC_HOST_TOKEN se mantiene para despliegues antiguos del Worker.)
NEXT_PUBLIC_HOST_TOKEN=cambia-este-token
